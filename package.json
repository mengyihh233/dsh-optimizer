{
  "name": "dsh-optimizer",
  "version": "0.1.1",
  "description": "DSH 优化插件：会话体检 / 归档 / 清理 + history 分页补丁管理（流式 chunk 事件不再拖慢会话切换）",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "performance",
    "optimizer",
    "session"
  ],
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-locale"
      ],
      "platform": "web"
    }
  },
  "files": [
    "lib",
    "src",
    "cordis.patch.yml",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=0.1.0-rc.0",
    "@deepseek-ai/dsh-tools": ">=0.1.0-rc.0"
  },
  "devDependencies": {
    "typescript": "^5.5.0",
    "@types/node": "^24.0.0"
  }
}
